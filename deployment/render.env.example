# FastSheba Render environment checklist
# Add these in Render Dashboard. Never commit real secret values.

APP_NAME=FastSheba
APP_ENV=production
APP_DEBUG=false
APP_URL=https://fastsheba-demo-api-56a8.onrender.com
APP_KEY=<php artisan key:generate --show>

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=mysql-3876fffe-sworkmail02-56a8.e.aivencloud.com
DB_PORT=23354
DB_DATABASE=defaultdb
DB_USERNAME=avnadmin
DB_PASSWORD=<AIVEN_PASSWORD>
MYSQL_SSL_CA_BASE64=<BASE64_OF_AIVEN_CA_CERTIFICATE>

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=sync

FILESYSTEM_DISK=local
MEDIA_DISK=cloudinary
MEDIA_CONVERSIONS_DISK=cloudinary
QUEUE_CONVERSIONS_BY_DEFAULT=false

CLOUDINARY_CLOUD_NAME=<YOUR_CLOUD_NAME>
CLOUDINARY_API_KEY=<YOUR_API_KEY>
CLOUDINARY_API_SECRET=<YOUR_API_SECRET>
CLOUDINARY_URL=cloudinary://<API_KEY>:<API_SECRET>@<CLOUD_NAME>
CLOUDINARY_SECURE=true
CLOUDINARY_ROOT_FOLDER=fastsheba

FRONTEND_URLS=http://localhost:3000
TRUSTED_PROXIES=*

MAIL_MAILER=log
FIREBASE_CREDENTIALS_BASE64=<OPTIONAL_BASE64_FIREBASE_JSON>
